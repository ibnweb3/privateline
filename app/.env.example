# PrivateLine settings. Copy to .env (gitignored); every value is optional on LocalNet.

# Website and SMS service
PORT=8790
# The address users see in texts, e.g. a tunnel to this machine.
PUBLIC_URL=http://localhost:8790

# Real SMS through SMS Gateway for Android (sms-gate.app, cloud mode). Without these, only the
# +999 simulator numbers work. Webhook: POST ${PUBLIC_URL}/sms/webhook, event sms:received.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_WEBHOOK_SECRET=
# On a dual-SIM gateway phone: only handle texts that arrive on this SIM, and send from it.
SMSGATE_SIM=

# Prices: "live" (Cantex + Yahoo Finance) or "replay" (the logged Sep 26 06:38 UTC snapshot).
PRICE_MODE=live
DESK_SPREAD=0.004

# Checker rules (both checkers use the same values)
PRICE_TOLERANCE=0.015
MAX_TRADE_DOLLARS=500
MAX_STARTING_DOLLARS=100
MAX_DAILY_LIMIT=1000
MAX_DEPOSIT=1000
# 24 hours in production. A LocalNet demo can use 120.
PHONE_CHANGE_COOLDOWN_SECONDS=86400

# New accounts
STARTING_DOLLARS=100
DAILY_LIMIT=200

# How long the SMS operator waits for a checker before giving up, and how often fills settle.
APPROVAL_TIMEOUT_MS=30000
SETTLE_INTERVAL_MS=300000

# Run the two checkers in this process (LocalNet demo). "off" when they run elsewhere.
CHECKERS=on

# 32+ bytes of hex. Without it a random one is generated in data/app-secret.
APP_SECRET=
